# Supabase
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Search APIs
NAVER_CLIENT_ID=your_naver_client_id
NAVER_CLIENT_SECRET=your_naver_client_secret
# Optional: 네이버 데이터랩 트렌드 후보 키워드 (최대 5개, 쉼표 구분)
# NAVER_TREND_KEYWORDS=AI,숏폼,유튜브,블로그,인스타그램
YOUTUBE_API_KEY=your_youtube_data_api_key
YOUCOM_API_KEY=your_youcom_api_key

# Optional: 콘텐츠 분석(AI 요약)용 Claude API 키. 없으면 요약 없이 나머지 분석만 동작.
# ANTHROPIC_API_KEY=your_anthropic_api_key

# 32+ random characters recommended. Used for AES-GCM key derivation.
NOTION_KEY_ENCRYPTION_SECRET=replace_with_a_long_random_secret

# Notion OAuth public integration
NOTION_CLIENT_ID=your_notion_oauth_client_id
NOTION_CLIENT_SECRET=your_notion_oauth_client_secret
NOTION_REDIRECT_URI=https://YOUR_PROJECT_REF.supabase.co/functions/v1/notion-oauth?action=callback
SETUP_PAGE_URL=https://pchanul.github.io/Snappy/

# 노션 템플릿 생성 스크립트용 (scripts/create-notion-template.js)
NOTION_API_KEY=your_notion_integration_secret
NOTION_TEMPLATE_PARENT_PAGE_ID=your_parent_page_id
# Optional: deploy.sh --yes에서 템플릿 링크 입력을 자동화할 때 사용
# NOTION_TEMPLATE_URL=https://your_published_notion_template_link

# GitHub Pages (optional; defaults are used when omitted)
GITHUB_PAGES_URL=https://pchanul.github.io/Snappy/
GITHUB_PAGES_BRANCH=main
GITHUB_PAGES_DIR=docs
GITHUB_PAGES_ENTRY=index.html

# Admin CLI (scripts/admin.js)
# Generate with: openssl rand -hex 32
ADMIN_SECRET=replace_with_a_long_random_secret

# Runtime
LOG_LEVEL=info
ENVIRONMENT=development
