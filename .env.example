# Supabase
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Search APIs
NAVER_CLIENT_ID=your_naver_client_id
NAVER_CLIENT_SECRET=your_naver_client_secret
YOUTUBE_API_KEY=your_youtube_data_api_key
YOUCOM_API_KEY=your_youcom_api_key

# 32+ random characters recommended. Used for AES-GCM key derivation.
NOTION_KEY_ENCRYPTION_SECRET=replace_with_a_long_random_secret

# 노션 템플릿 생성 스크립트용 (scripts/create-notion-template.js)
NOTION_API_KEY=secret_your_notion_integration_key
NOTION_TEMPLATE_PARENT_PAGE_ID=your_parent_page_id

# GitHub Pages (optional; defaults are used when omitted)
GITHUB_PAGES_URL=https://pchanul.github.io/Snappy/
GITHUB_PAGES_BRANCH=main
GITHUB_PAGES_DIR=docs
GITHUB_PAGES_ENTRY=index.html

# Admin CLI (scripts/admin.js)
# Generate with: openssl rand -hex 32
ADMIN_SECRET=replace_with_a_long_random_secret

# Runtime
LOG_LEVEL=info
ENVIRONMENT=development
